# Existing notification webhook settings. A webhook cannot receive messages.
# The monitor replies through the custom app API, not through this webhook.
PAPER_BOT_URL=
PAPER_BOT_KEY=

# Receiving requires credentials from a Feishu custom app with bot capability.
# Summary replies additionally need im:message:send_as_bot permission.
PAPER_APP_ID=cli_your_app_id
PAPER_APP_SECRET=

# AI settings follow download_paper.sh. Configure these in local_env.sh or
# export them in your shell; .env files are not loaded automatically.
CODEX_PROXY_BASE_URL=http://127.0.0.1:8787/v1
CODEX_PROXY_API_KEY=codex-proxy
AI_MODEL=gpt-6-astra
